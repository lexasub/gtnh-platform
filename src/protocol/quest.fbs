// protocol/quest.fbs
// Quest Book protocol: quest data, completion tracking, progression events.
// Quest data (CSV + JSON) is loaded from data/quests/ at service startup.
// Quest progress per player is stored in MetaDB (SQLite).
// FlatBuffers messages flow through MessageRouter and Gateway.

include "core.fbs";

namespace Protocol;

// ---------------------------------------------------------------------------
// Value types
// ---------------------------------------------------------------------------

// Quest completion status
enum QuestStatus : uint8 {
  LOCKED = 0,
  AVAILABLE = 1,
  IN_PROGRESS = 2,
  COMPLETED = 3,
}

// ---------------------------------------------------------------------------
// Client ↔ Gateway quest messages
// ---------------------------------------------------------------------------

// Sent to client when quest progress changes.
// Contains the complete list of quest statuses for the player
// (diff-based: client merges with local state).
table QuestProgressUpdate {
  player_id:uint64;
  quests:[QuestEntry];
}

// Individual quest progress entry
table QuestEntry {
  quest_id:uint32;
  status:QuestStatus = LOCKED;
  progress:uint8 = 0;         // 0-100 percent for sub-task tracking
}

// Client → server: request manual completion of an AVAILABLE quest.
// The server validates status + prerequisites and transitions AVAILABLE→COMPLETED
// before any reward is granted. Never send status updates directly (quest.set).
table QuestCompleteRequest {
  player_id:uint64;
  quest_id:uint32;
}

// Client → server: request an exchange on a repeatable market quest
// (DetectionType::EXCHANGE). The quest never completes; each accepted
// exchange consumes cost items, grants the reward, and starts a cooldown.
table QuestExchangeRequest {
  player_id:uint64;
  quest_id:uint32;
}

// Client → server: the player opened the quest book. Triggers a server-side
// inventory check against INVENTORY-type quest objectives
// (DetectionType::INVENTORY): each such quest whose detectTarget item is held
// in quantity >= targetCount completes when prerequisites are met. No
// response — completion notifications flow back via quest.completed /
// quest.progress.updated / quest.unlocked.
table QuestBookOpen {
  player_id:uint64;
}

// Server → client: result of an exchange request. On success the cooldown is
// (re)started; cooldown_remaining_secs carries the active cooldown in both
// success and cooldown_active cases.
table QuestExchangeResponse {
  player_id:uint64;
  quest_id:uint32;
  success:bool;
  error_message:string;         // "" on success; "unknown_quest" | "not_exchange" | "cooldown_active" | "missing_items"
  cooldown_remaining_secs:uint32; // 0 = no cooldown
}

// Client → server: query remaining cooldown for an exchange quest
// (sent when the quest detail view opens).
table QuestExchangeCooldownGet {
  player_id:uint64;
  quest_id:uint32;
}

// Server → client: cooldown status for an exchange quest.
table QuestExchangeCooldown {
  player_id:uint64;
  quest_id:uint32;
  cooldown_remaining_secs:uint32; // 0 = no active cooldown
}

// Server → client: notify when new quests become available
table QuestUnlockNotification {
  player_id:uint64;
  unlocked_ids:[uint32];      // quest IDs that just became available
}

// Server → client: notify when a quest is completed
table QuestCompletedNotification {
  player_id:uint64;
  quest_id:uint32;
  reward_item_id:uint16;
  reward_count:uint8;
}

// Server → client: notify when all quests in an era reach COMPLETED status.
// completed_era / next_era carry quest::Era values (VAGRANT=0, APPRENTICE=1,
// EXPERT=2, ADMINISTRATOR=3). next_era equals completed_era when the final
// era is done (no next era exists).
table EraTransitionNotification {
  player_id:uint64;
  completed_era:uint8;
  next_era:uint8;
}

// ---------------------------------------------------------------------------
// Events (pub/sub via MessageRouter)
// ---------------------------------------------------------------------------

// Published by SimulationCore when quest completion is detected.
// Consumed by MetaDB to persist, and by Gateway to forward to client.
table QuestCompleted {
  player_id:uint64;
  quest_id:uint32;
  timestamp:uint64;           // unix nanos
}

// Published by the quest manager when the DAG unlocks new quests.
table QuestUnlocked {
  player_id:uint64;
  unlocked_quest_ids:[uint32];
}
