// protocol/recipe.fbs
// RecipeManager RPC: request/reply over length-prefixed TCP frames.
// Frame: [4 bytes: big-endian payload size] [FlatBuffer: RecipeMessage | RecipeReply]

include "core.fbs";

namespace Protocol;

// ---------------------------------------------------------------------------
// Value types (struct = inline, zero-copy)
// ---------------------------------------------------------------------------

// Container: fixed-size array of ItemStack for machine inventory
// slot 0 = machine output/input, slots 1-8 = inventory
// TODO: This is a simplified container; may be replaced with vector in future
struct Container {
  items:[ItemStack:9];
  dirty:uint8;
  size:uint16;
}

// ---------------------------------------------------------------------------
// Request types
// ---------------------------------------------------------------------------
table CheckRecipeReq {
  container:Container;
  machine_id:uint16;
}

table CraftReq {
  recipe_id:string;
  container:Container;
}

table EvaluateConditionsReq {
  recipe_id:string;
}

// Client asks for the compact catalog of item ids that appear in any recipe
// (inputs or outputs). Used for "what recipes exist" and to know what is
// queryable before issuing per-item / per-machine requests.
table RecipeCatalogReq {
}

// Recipes involving a single item: mode 0 = both, 1 = craft (item is an
// output), 2 = use (item is an input). "How is X crafted / where is X used".
table RecipesForItemReq {
  item_id:uint16;
  mode:uint8;
}

// All recipes a machine class can run (NEI-style listing for a block_id).
table RecipesForMachineReq {
  machine_id:uint16;
}

union RecipeRequest {
  CheckRecipeReq,
  CraftReq,
  EvaluateConditionsReq,
  RecipeCatalogReq,
  RecipesForItemReq,
  RecipesForMachineReq,
}
// ---------------------------------------------------------------------------
// Response types
// ---------------------------------------------------------------------------

table CheckRecipeResp {
  recipe_id:string;
  // Matched recipe details (output + pattern + inputs) so the client can show
  // the result slot / preview without a second round trip. Null on no match.
  recipe:RecipeInfo;
}

table CraftResp {
  new_container:Container;
}

table EvaluateConditionsResp {
  success:bool;
}

table RecipeInfo {
  machine_type:uint16;
  machine_class:string;
  recipe_id:string;
  duration:uint32;
  inputs:[ItemStack];
  outputs:[ItemStack];
  // Positional 3x3 pattern (9 entries, item_id 0 = empty cell). Only set for
  // has_pattern recipes.
  has_pattern:bool;
  pattern:[ItemStack];
}

table RecipeCatalogResp {
  item_ids:[ushort];
}

table RecipesForItemResp {
  recipes:[RecipeInfo];
}

table RecipesForMachineResp {
  recipes:[RecipeInfo];
}

union RecipeResponse {
  CheckRecipeResp,
  CraftResp,
  EvaluateConditionsResp,
  ErrorResp,
  RecipeCatalogResp,
  RecipesForItemResp,
  RecipesForMachineResp,
}

// ---------------------------------------------------------------------------
// Event types (pub/sub events, not RPC)
// ---------------------------------------------------------------------------

// Published by reciped when a recipe completes (both instant and timed).
// simcored subscribes and replaces the entity's inventory with result_slots.
table RecipeCompleted {
  pos:Vec3i (required);
  machine_id:uint16;
  recipe_id:string (required);
  result_slots:[ItemStack];  // full inventory contents after craft (inputs consumed + outputs)
}

// ---------------------------------------------------------------------------
// Wire wrappers
// ---------------------------------------------------------------------------
table RecipeMessage {
  req_id:uint32;
  request:RecipeRequest;
}

table RecipeReply {
  req_id:uint32;
  response:RecipeResponse;
}

union RecipePayload {
  RecipeMessage,
  RecipeReply,
}

table RecipeFrame {
  payload:RecipePayload (required);
}

root_type RecipeFrame;
